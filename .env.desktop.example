# Copie para .env.desktop na raiz. Os enderecos sao publicos, nao segredos.
# Docker Compose: frontend/Nginx publicado em WEB_PORT (80 por padrao).
# Nginx encaminha /api/ para o container Java.
DESKTOP_API_URL=http://127.0.0.1/api/
DESKTOP_PUBLIC_APP_URL=http://127.0.0.1/

# Se WEB_PORT=8081, use http://127.0.0.1:8081/api/ e http://127.0.0.1:8081/.
# Esses valores locais tambem sao os padroes quando nao ha .env.desktop.
# Desktop e API precisam estar conectados; esta versao nao oferece modo offline.
