{
  "name": "events-by-mc-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "EventsByMc para Windows",
  "author": "Equipe EventsByMc",
  "main": "desktop/main.cjs",
  "scripts": {
    "desktop:install": "install-electron",
    "desktop:dev": "node desktop/scripts/dev.cjs",
    "desktop:build": "node desktop/scripts/build.cjs",
    "desktop:start": "electron .",
    "desktop:smoke": "node desktop/scripts/smoke.cjs",
    "desktop:pack": "npm run desktop:build && electron-builder --win --dir",
    "desktop:dist": "npm run desktop:build && electron-builder --win nsis",
    "presenca:rede": "node desktop/scripts/configurar-rede.cjs",
    "test": "node --test desktop/tests/*.test.cjs",
    "lint": "node desktop/scripts/check.cjs"
  },
  "build": {
    "appId": "br.com.eventsbymc.desktop",
    "productName": "EventsByMc",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/config.cjs",
      "desktop/servidor.cjs",
      "desktop/protocol.cjs",
      "frontend/tools/endereco-presenca.cjs",
      "desktop/runtime-config.json",
      "desktop/renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "include": "desktop/installer/servidor.nsh",
      "installerLanguages": ["pt_BR"],
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "wait-on": "^9.5.1"
  }
}
